{
    "name": "ossos",
    "version": "0.0.4",
    "author": "Pedro Sousa ( Vor @ SketchPunk Labs )",
    "description": "Character Animation System",
    "keywords": [
        "animation",
        "skeleton",
        "inverse kinematrics",
        "armature",
        "ikrig"
    ],
    "license": "MIT",
    "homepage": "https://github.com/sketchpunklabs/ossos#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sketchpunklabs/ossos.git"
    },
    "bugs": {
        "url": "https://github.com/sketchpunklabs/ossos/issues"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "./dist/ossos.cjs.js",
    "module": "./dist/ossos.es.js",
    "types": "./dist/ossos.d.ts",
    "exports": {
        ".": {
            "import": "./dist/ossos.es.js",
            "require": "./dist/ossos.cjs.js"
        }
    },
    "scripts": {
        "dev": "vite --config vite.config.js",
        "build": "vite build",
        "buid:post": "terser dist/ossos.mjs -o dist/ossos.min.js --config-file terser.config.json",
        "build:types": "tsc --declaration --noEmit false --emitDeclarationOnly --strict false --outDir ./dist",
        "build:site": "vite build --mode site",
        "pack": "npm pack",
        "preview-site": "vite preview",
        "lint": "eslint . --ext .ts",
        "pnpm:dev": "pnpm run dev"
    },
    "devDependencies": {
        "@eslint/js": "^9.30.1",
        "@stylistic/eslint-plugin": "^5.1.0",
        "@typescript-eslint/eslint-plugin": "^8.36.0",
        "@typescript-eslint/parser": "^8.36.0",
        "eslint": "^9.3.0",
        "terser": "^5.43.1",
        "three": "^0.148.0",
        "typescript": "^5.0.3",
        "vite": "^4.0.0",
        "vite-plugin-list-directory-contents": "^1.4.5"
    },
    "peerDependencies": {
        "gl-matrix": "^3.4.3"
    }
}
